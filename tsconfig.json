{
    "compilerOptions": {
        "module": "node16",
        "lib": [
            "es6"
        ],
        "noImplicitAny": true,
        "noImplicitThis": true,
        "strictFunctionTypes": true,
        "strictNullChecks": true,
        "types": [],
        "noEmit": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "index.d.ts",
        "memento-database-tests.ts",
        "modules/**/*"
    ]
}
